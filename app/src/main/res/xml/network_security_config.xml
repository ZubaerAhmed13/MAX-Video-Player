<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTP is reachable only after the app's explicit user-destination warning/acknowledgement.
         TLS continues to use the Android system trust store with normal hostname verification. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
